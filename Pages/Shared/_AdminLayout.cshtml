@inject IStripeCredentialProvider CredentialProvider
@{
    var hasCredentials = CredentialProvider.HasValidCredentials();
    var credentialSource = CredentialProvider.GetCurrentSource();
    var isTestMode = CredentialProvider.IsTestMode();
    var credentials = CredentialProvider.GetCredentials();
    var currentPath = Context.Request.Path.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Stripe Demo</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-100">
    <!-- Top Bar -->
    <header class="bg-gray-900 text-white">
        <div class="flex justify-between items-center px-6 py-3">
            <div class="flex items-center gap-4">
                <span class="text-lg font-semibold">Admin Panel</span>
                <span class="text-gray-400">|</span>
                @if (hasCredentials)
                {
                    <span class="text-sm text-gray-300">
                        @(isTestMode ? "Test Mode" : "Live Mode") -
                        @(credentialSource == CredentialSource.Session ? "Your Keys" : "Demo Keys")
                    </span>
                }
                else
                {
                    <span class="text-sm text-yellow-400">Credentials not configured</span>
                }
            </div>
            <a href="/" class="inline-flex items-center gap-2 text-gray-300 hover:text-white text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Shop
            </a>
        </div>
    </header>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-white min-h-[calc(100vh-52px)] border-r border-gray-200 p-4">
            <nav class="space-y-1">
                <a href="/Admin" class="admin-nav-link @(currentPath == "/Admin" || currentPath == "/Admin/" ? "admin-nav-link-active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                    </svg>
                    Dashboard
                </a>
                <a href="/Admin/Credentials" class="admin-nav-link @(currentPath.StartsWith("/Admin/Credentials") ? "admin-nav-link-active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                    </svg>
                    Credentials
                </a>
                <a href="/Admin/Webhooks" class="admin-nav-link @(currentPath.StartsWith("/Admin/Webhooks") ? "admin-nav-link-active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    Webhooks
                </a>
                <a href="/Admin/Security" class="admin-nav-link @(currentPath.StartsWith("/Admin/Security") ? "admin-nav-link-active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    Security
                </a>
                <a href="/Admin/Docs" class="admin-nav-link @(currentPath.StartsWith("/Admin/Docs") ? "admin-nav-link-active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                    Documentation
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-8">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
