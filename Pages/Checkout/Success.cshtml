@page
@model PaymentDemo.Pages.Checkout.SuccessModel
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    @if (Model.Order != null)
    {
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Payment Successful!</h1>
            <p class="text-lg text-gray-600">Thank you for your order.</p>
        </div>

        <div class="card mb-8">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">Order @Model.Order.Id</h2>
                    <p class="text-sm text-gray-500">@Model.Order.CreatedAt.ToString("MMMM d, yyyy 'at' h:mm tt") UTC</p>
                </div>
                <span class="@Model.Order.StatusBadgeClass badge">@Model.Order.StatusDisplay</span>
            </div>

            <div class="border-t border-gray-200 pt-6">
                <h3 class="font-medium text-gray-900 mb-4">Order Summary</h3>
                <div class="space-y-3">
                    @foreach (var item in Model.Order.Items)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">@item.ProductName x @item.Quantity</span>
                            <span class="font-medium">$@item.Total.ToString("0.00")</span>
                        </div>
                    }
                    <div class="flex justify-between text-sm pt-2">
                        <span class="text-gray-600">Tax</span>
                        <span class="font-medium">$@Model.Order.Tax.ToString("0.00")</span>
                    </div>
                    <div class="flex justify-between text-base font-semibold border-t border-gray-200 pt-3 mt-3">
                        <span>Total</span>
                        <span>$@Model.Order.Total.ToString("0.00")</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Order.StripePaymentIntentId))
            {
                <div class="border-t border-gray-200 pt-4 mt-6">
                    <p class="text-xs text-gray-500">
                        Payment ID: <code class="code">@Model.Order.StripePaymentIntentId</code>
                    </p>
                </div>
            }
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/Orders" class="btn-primary">
                View All Orders
            </a>
            <a href="/Shop" class="btn-secondary">
                Continue Shopping
            </a>
        </div>

        <!-- Webhook Note -->
        <div class="mt-10 p-4 bg-blue-50 rounded-lg text-center">
            <p class="text-sm text-blue-800">
                <strong>Note:</strong> Order status is updated via Stripe webhooks.
                If you're testing locally, make sure the Stripe CLI is forwarding webhooks.
            </p>
        </div>
    }
    else
    {
        <div class="text-center">
            <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Session Not Found</h1>
            <p class="text-gray-600 mb-8">We couldn't find an order for this checkout session.</p>
            <a href="/Shop" class="btn-primary">
                Continue Shopping
            </a>
        </div>
    }
</div>
