@page "/cart"
@model PaymentDemo.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Cart";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Shopping Cart</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
                @Model.ErrorMessage
            </div>
        </div>
    }

    @if (Model.Cart.IsEmpty)
    {
        <!-- Empty Cart State -->
        <div class="card text-center py-16">
            <svg class="w-16 h-16 mx-auto mb-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Your cart is empty</h2>
            <p class="text-gray-600 mb-6">Add some products to get started!</p>
            <a href="/Shop" class="btn-primary">
                Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="grid lg:grid-cols-3 gap-8">
            <!-- Cart Items -->
            <div class="lg:col-span-2">
                <div class="card divide-y divide-gray-100">
                    @foreach (var item in Model.Cart.Items)
                    {
                        var product = PaymentDemo.Models.ProductCatalog.GetById(item.ProductId);
                        <div class="py-6 first:pt-0 last:pb-0">
                            <div class="flex gap-4">
                                <!-- Product Image -->
                                <div class="flex-shrink-0 w-24 h-24 bg-gradient-to-br @(product?.GradientFrom ?? "from-gray-400") @(product?.GradientTo ?? "to-gray-600") rounded-lg flex items-center justify-center">
                                    <svg class="w-10 h-10 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="@(product?.Icon ?? "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4")"></path>
                                    </svg>
                                </div>

                                <!-- Product Details -->
                                <div class="flex-1">
                                    <h3 class="font-semibold text-gray-900">@item.ProductName</h3>
                                    <p class="text-sm text-gray-500">@Model.CurrencySymbol@item.UnitPrice.ToString("0.00") each</p>

                                    <!-- Quantity Controls -->
                                    <div class="flex items-center gap-3 mt-3">
                                        <form method="post" asp-page-handler="UpdateQuantity" class="flex items-center gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                                    class="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center hover:bg-gray-100 transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                                </svg>
                                            </button>
                                            <span class="w-8 text-center font-medium">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)"
                                                    class="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center hover:bg-gray-100 transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="RemoveItem">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="text-red-600 text-sm hover:underline">
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <!-- Item Total -->
                                <div class="text-right">
                                    <span class="font-semibold text-gray-900">@Model.CurrencySymbol@item.Total.ToString("0.00")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Continue Shopping -->
                <div class="mt-6">
                    <a href="/Shop" class="text-brand-600 hover:underline text-sm font-medium">
                        &larr; Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="lg:col-span-1">
                <div class="card sticky top-8">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Order Summary</h2>

                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Subtotal (@Model.Cart.ItemCount items)</span>
                            <span class="font-medium">@Model.CurrencySymbol@Model.Cart.Subtotal.ToString("0.00")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Tax (8%)</span>
                            <span class="font-medium">@Model.CurrencySymbol@Model.Cart.Tax.ToString("0.00")</span>
                        </div>
                        <div class="border-t border-gray-200 pt-3">
                            <div class="flex justify-between text-base">
                                <span class="font-semibold">Total</span>
                                <span class="font-bold text-lg">@Model.CurrencySymbol@Model.Cart.Total.ToString("0.00")</span>
                            </div>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="Checkout" class="mt-6">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary w-full">
                            Proceed to Checkout
                        </button>
                    </form>

                    <div class="mt-4 flex items-center justify-center gap-2 text-xs text-gray-500">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                        Secure checkout powered by Stripe
                    </div>
                </div>
            </div>
        </div>
    }
</div>
