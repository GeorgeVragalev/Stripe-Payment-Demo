@page "/shop"
@model PaymentDemo.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Shop";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900 mb-4">Our Products</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Select from our demo products below. This is a test environment - no real charges will be made.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-6 max-w-2xl mx-auto flex items-center gap-3">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>@Model.SuccessMessage</span>
            <a href="/Cart" class="ml-auto text-green-700 font-medium hover:underline">View Cart &rarr;</a>
        </div>
    }

    @if (!Model.HasCredentials)
    {
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 mb-8 max-w-2xl mx-auto">
            <div class="flex gap-4">
                <svg class="w-6 h-6 text-yellow-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <div>
                    <h3 class="text-lg font-semibold text-yellow-800 mb-2">Credentials Required</h3>
                    <p class="text-yellow-700 mb-4">
                        You need to configure Stripe credentials before you can make purchases.
                    </p>
                    <a href="/Admin/Credentials" class="btn-primary bg-yellow-600 hover:bg-yellow-700 text-sm">
                        Configure Credentials
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Products Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var product in Model.Products)
        {
            <div class="card flex flex-col @(product.IsPopular ? "border-2 border-brand-500 relative" : "")">
                @if (product.IsPopular)
                {
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                        <span class="bg-brand-500 text-white text-xs font-bold px-3 py-1 rounded-full">POPULAR</span>
                    </div>
                }
                <div class="bg-gradient-to-br @product.GradientFrom @product.GradientTo h-48 rounded-lg mb-6 flex items-center justify-center">
                    <svg class="w-20 h-20 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="@product.Icon"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">@product.Name</h3>
                <p class="text-gray-600 text-sm mb-4 flex-1">
                    @product.Description
                </p>
                <div class="flex items-baseline gap-1 mb-4">
                    <span class="text-3xl font-bold text-gray-900">@Model.CurrencySymbol@product.Price.ToString("0.00")</span>
                    <span class="text-gray-500">/month</span>
                </div>
                <form method="post" asp-page-handler="AddToCart">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit" class="btn-primary w-full" @(Model.HasCredentials ? "" : "disabled")>
                        Add to Cart
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- Info Box -->
    <div class="mt-12 bg-gray-100 rounded-xl p-6 max-w-2xl mx-auto text-center">
        <p class="text-gray-600 text-sm">
            <strong>This is a demo.</strong> Use test card
            <code class="code">4242 4242 4242 4242</code>
            with any future expiry date and CVC.
        </p>
    </div>
</div>
