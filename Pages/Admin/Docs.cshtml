@page
@model PaymentDemo.Pages.Admin.DocsModel
@{
    ViewData["Title"] = "Documentation";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl">
    <h1 class="section-heading">How It Works</h1>

    <p class="text-lg text-gray-600 mb-8">
        This demo showcases a complete Stripe Checkout integration with webhook handling.
        Here's how the payment flow works:
    </p>

    <!-- Flow Diagram -->
    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-6">Payment Flow</h2>

        <div class="space-y-6">
            <!-- Step 1 -->
            <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                    <span class="text-brand-700 font-bold">1</span>
                </div>
                <div class="flex-1 pb-6 border-l-2 border-gray-200 pl-6 -ml-5 relative">
                    <div class="absolute w-3 h-3 bg-brand-500 rounded-full -left-[7px] top-3"></div>
                    <h3 class="font-semibold text-gray-900 mb-2">Customer Adds Items to Cart</h3>
                    <p class="text-gray-600 text-sm">
                        The customer browses products and adds items to their shopping cart.
                        Cart is stored in the browser session.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                    <span class="text-brand-700 font-bold">2</span>
                </div>
                <div class="flex-1 pb-6 border-l-2 border-gray-200 pl-6 -ml-5 relative">
                    <div class="absolute w-3 h-3 bg-brand-500 rounded-full -left-[7px] top-3"></div>
                    <h3 class="font-semibold text-gray-900 mb-2">Create Checkout Session</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        When the customer clicks "Checkout", we create a Stripe Checkout Session
                        with line items and metadata (order ID).
                    </p>
                    <div class="bg-gray-900 rounded-lg p-4 text-sm overflow-x-auto">
                        <pre class="text-gray-100"><code>var options = new SessionCreateOptions
{
    LineItems = cartItems,
    Mode = "payment",
    SuccessUrl = "https://yoursite.com/success?session_id={CHECKOUT_SESSION_ID}",
    CancelUrl = "https://yoursite.com/cancel",
    Metadata = new Dictionary&lt;string, string&gt;
    {
        { "order_id", orderId }
    }
};</code></pre>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                    <span class="text-brand-700 font-bold">3</span>
                </div>
                <div class="flex-1 pb-6 border-l-2 border-gray-200 pl-6 -ml-5 relative">
                    <div class="absolute w-3 h-3 bg-brand-500 rounded-full -left-[7px] top-3"></div>
                    <h3 class="font-semibold text-gray-900 mb-2">Redirect to Stripe Checkout</h3>
                    <p class="text-gray-600 text-sm">
                        The customer is redirected to Stripe's hosted checkout page where they
                        enter payment details securely. We never handle card numbers directly.
                    </p>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                    <span class="text-brand-700 font-bold">4</span>
                </div>
                <div class="flex-1 pb-6 border-l-2 border-gray-200 pl-6 -ml-5 relative">
                    <div class="absolute w-3 h-3 bg-brand-500 rounded-full -left-[7px] top-3"></div>
                    <h3 class="font-semibold text-gray-900 mb-2">Stripe Sends Webhook</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        After successful payment, Stripe sends a <code class="code">checkout.session.completed</code>
                        webhook to our server. We verify the signature and update the order.
                    </p>
                    <div class="bg-gray-900 rounded-lg p-4 text-sm overflow-x-auto">
                        <pre class="text-gray-100"><code>var stripeEvent = EventUtility.ConstructEvent(
    json,
    Request.Headers["Stripe-Signature"],
    webhookSecret
);

if (stripeEvent.Type == "checkout.session.completed")
{
    var session = stripeEvent.Data.Object as Session;
    var orderId = session.Metadata["order_id"];
    // Update order status to "Paid"
}</code></pre>
                    </div>
                </div>
            </div>

            <!-- Step 5 -->
            <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                </div>
                <div class="flex-1 pl-6 -ml-5 relative">
                    <div class="absolute w-3 h-3 bg-green-500 rounded-full -left-[7px] top-3"></div>
                    <h3 class="font-semibold text-gray-900 mb-2">Order Complete</h3>
                    <p class="text-gray-600 text-sm">
                        The customer is redirected back to our success page. The order status
                        has been updated via webhook (not by the redirect - webhooks are authoritative).
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Concepts -->
    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Key Concepts</h2>

        <div class="space-y-4">
            <div>
                <h3 class="font-medium text-gray-900">Why Webhooks?</h3>
                <p class="text-sm text-gray-600">
                    The success redirect URL can be manipulated by users. Webhooks are the
                    authoritative source of payment status. Always rely on webhooks to update order status.
                </p>
            </div>

            <div>
                <h3 class="font-medium text-gray-900">Idempotency</h3>
                <p class="text-sm text-gray-600">
                    Stripe may send the same webhook multiple times. We track processed event IDs
                    to ensure each event is only processed once.
                </p>
            </div>

            <div>
                <h3 class="font-medium text-gray-900">Signature Verification</h3>
                <p class="text-sm text-gray-600">
                    Every webhook includes a signature header. We verify this signature using our
                    webhook secret to ensure the request came from Stripe.
                </p>
            </div>
        </div>
    </div>

    <!-- Test Cards -->
    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Test Card Numbers</h2>

        <div class="grid sm:grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                    <div class="status-dot status-dot-success"></div>
                    <span class="font-medium text-gray-900">Successful Payment</span>
                </div>
                <code class="text-lg font-mono text-green-600">4242 4242 4242 4242</code>
            </div>

            <div class="bg-gray-50 rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                    <div class="status-dot status-dot-warning"></div>
                    <span class="font-medium text-gray-900">3D Secure Required</span>
                </div>
                <code class="text-lg font-mono text-yellow-600">4000 0000 0000 3220</code>
            </div>

            <div class="bg-gray-50 rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                    <div class="status-dot status-dot-error"></div>
                    <span class="font-medium text-gray-900">Card Declined</span>
                </div>
                <code class="text-lg font-mono text-red-600">4000 0000 0000 9995</code>
            </div>

            <div class="bg-gray-50 rounded-lg p-4">
                <div class="flex items-center gap-2 mb-2">
                    <div class="status-dot status-dot-error"></div>
                    <span class="font-medium text-gray-900">Expired Card</span>
                </div>
                <code class="text-lg font-mono text-red-600">4000 0000 0000 0069</code>
            </div>
        </div>

        <p class="text-sm text-gray-500 mt-4">
            Use any future expiry date and any 3-digit CVC.
        </p>
    </div>

    <!-- Stripe CLI -->
    <div class="card">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Testing Webhooks Locally</h2>

        <ol class="list-decimal list-inside space-y-3 text-sm text-gray-600">
            <li>
                Install the Stripe CLI:
                <a href="https://stripe.com/docs/stripe-cli" target="_blank" rel="noopener" class="text-brand-600 hover:underline">
                    stripe.com/docs/stripe-cli
                </a>
            </li>
            <li>Login: <code class="code">stripe login</code></li>
            <li>
                Forward webhooks:
                <div class="bg-gray-900 rounded-lg p-3 mt-2">
                    <code class="text-green-400">stripe listen --forward-to https://localhost:5001/api/webhooks/stripe</code>
                </div>
            </li>
            <li>Copy the webhook signing secret (whsec_xxx) and add it to your credentials</li>
            <li>Make a test payment and watch the events flow through!</li>
        </ol>
    </div>
</div>
