@page
@model PaymentDemo.Pages.Admin.WebhooksModel
@{
    ViewData["Title"] = "Webhooks";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl">
    <div class="flex justify-between items-center mb-6">
        <h1 class="section-heading mb-0">Webhook Events</h1>
        @if (Model.Events.Any())
        {
            <form method="post" asp-page-handler="Clear">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-secondary text-sm py-2">
                    Clear Logs
                </button>
            </form>
        }
    </div>

    @if (!Model.HasWebhookSecret)
    {
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 mb-8">
            <div class="flex gap-4">
                <svg class="w-6 h-6 text-yellow-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <div>
                    <h3 class="text-lg font-semibold text-yellow-800 mb-2">Webhook Secret Not Configured</h3>
                    <p class="text-yellow-700 mb-4">
                        To receive and verify webhooks, you need to configure a webhook signing secret.
                    </p>
                    <a href="/Admin/Credentials" class="btn-primary bg-yellow-600 hover:bg-yellow-700 text-sm">
                        Configure Credentials
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Webhook Endpoint Info -->
    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Webhook Endpoint</h2>
        <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-sm text-gray-600 mb-2">Configure this URL in your Stripe Dashboard or use Stripe CLI:</p>
            <code class="code text-sm">@Model.WebhookUrl</code>
        </div>

        <div class="mt-4 p-4 bg-gray-900 rounded-lg">
            <p class="text-sm text-gray-400 mb-2">Stripe CLI command:</p>
            <code class="text-sm text-green-400">stripe listen --forward-to @Model.WebhookUrl</code>
        </div>
    </div>

    <!-- Events Table -->
    <div class="card">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Events</h2>

        @if (Model.Events.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-200">
                            <th class="text-left py-3 px-4 font-semibold text-gray-700">Timestamp</th>
                            <th class="text-left py-3 px-4 font-semibold text-gray-700">Event Type</th>
                            <th class="text-left py-3 px-4 font-semibold text-gray-700">Order ID</th>
                            <th class="text-center py-3 px-4 font-semibold text-gray-700">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var evt in Model.Events)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="py-3 px-4 text-gray-500">@evt.Timestamp.ToString("HH:mm:ss")</td>
                                <td class="py-3 px-4 font-medium text-gray-900">@evt.EventType</td>
                                <td class="py-3 px-4">
                                    @if (!string.IsNullOrEmpty(evt.OrderId))
                                    {
                                        <code class="code text-xs">@evt.OrderId</code>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">-</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @if (evt.Success)
                                    {
                                        <span class="badge badge-success">Success</span>
                                    }
                                    else if (evt.IsDuplicate)
                                    {
                                        <span class="badge badge-warning">Duplicate</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-error">Failed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12 text-gray-500">
                <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <p>No webhook events received yet</p>
                <p class="text-sm mt-1">Complete a checkout to see events here</p>
            </div>
        }
    </div>
</div>
