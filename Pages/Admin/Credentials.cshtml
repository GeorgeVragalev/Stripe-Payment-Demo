@page
@model PaymentDemo.Pages.Admin.CredentialsModel
@{
    ViewData["Title"] = "Credentials";
    Layout = "_AdminLayout";
}

<div class="max-w-4xl">
    <h1 class="section-heading">Stripe Credentials</h1>

    <!-- Current Configuration Status -->
    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Current Configuration</h2>

        <div class="flex items-center gap-4 mb-4">
            @if (Model.HasCredentials)
            {
                <div class="flex items-center gap-2">
                    <div class="status-dot status-dot-success"></div>
                    <span class="font-medium text-green-700">Connected</span>
                </div>
                @if (Model.IsTestMode)
                {
                    <span class="badge badge-warning">Test Mode</span>
                }
                else
                {
                    <span class="badge badge-error">Live Mode</span>
                }
            }
            else
            {
                <div class="flex items-center gap-2">
                    <div class="status-dot status-dot-error"></div>
                    <span class="font-medium text-red-700">Not Configured</span>
                </div>
            }
        </div>

        @if (Model.HasCredentials)
        {
            <div class="bg-gray-50 rounded-lg p-4 space-y-2 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-600">Source:</span>
                    <span class="font-medium">
                        @if (Model.CredentialSource == CredentialSource.Session)
                        {
                            <span class="text-blue-700">Your Credentials (Session)</span>
                        }
                        else
                        {
                            <span class="text-green-700">Demo/Environment Configuration</span>
                        }
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-600">Public Key:</span>
                    <code class="code">@Model.MaskedPublicKey</code>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-600">Secret Key:</span>
                    <code class="code">@Model.MaskedSecretKey</code>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-600">Webhook Secret:</span>
                    <code class="code">@Model.MaskedWebhookSecret</code>
                </div>
                @if (Model.ConfiguredAt.HasValue)
                {
                    <div class="flex justify-between">
                        <span class="text-gray-600">Configured:</span>
                        <span class="font-medium">@Model.ConfiguredAt.Value.ToString("g") UTC</span>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                @Model.SuccessMessage
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
                @Model.ErrorMessage
            </div>
        </div>
    }

    <!-- Use Your Own Credentials -->
    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-2">Use Your Own Credentials</h2>
        <p class="text-sm text-gray-600 mb-6">
            Enter your Stripe test API keys to test with your own account.
            Credentials are stored only in your browser session and are never persisted to disk.
        </p>

        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
            <div class="flex gap-3">
                <svg class="w-5 h-5 text-yellow-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                </svg>
                <div class="text-sm text-yellow-800">
                    <p class="font-medium">Only test keys are accepted</p>
                    <p>Keys starting with <code class="bg-yellow-100 px-1 rounded">sk_test_</code> and <code class="bg-yellow-100 px-1 rounded">pk_test_</code> only. Live keys will be rejected.</p>
                </div>
            </div>
        </div>

        <form method="post" asp-page-handler="SetCredentials">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label asp-for="Input.SecretKey" class="form-label">Secret Key</label>
                    <input asp-for="Input.SecretKey"
                           class="form-input font-mono"
                           placeholder="sk_test_..."
                           autocomplete="off" />
                    <span asp-validation-for="Input.SecretKey" class="text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.PublicKey" class="form-label">Publishable Key</label>
                    <input asp-for="Input.PublicKey"
                           class="form-input font-mono"
                           placeholder="pk_test_..."
                           autocomplete="off" />
                    <span asp-validation-for="Input.PublicKey" class="text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.WebhookSecret" class="form-label">
                        Webhook Secret
                        <span class="text-gray-400 font-normal">(optional)</span>
                    </label>
                    <input asp-for="Input.WebhookSecret"
                           class="form-input font-mono"
                           placeholder="whsec_..."
                           autocomplete="off" />
                    <span asp-validation-for="Input.WebhookSecret" class="text-sm text-red-600"></span>
                    <p class="text-xs text-gray-500 mt-1">
                        Get this from Stripe CLI: <code class="code">stripe listen --forward-to ...</code>
                    </p>
                </div>

                <button type="submit" class="btn-primary">
                    Validate & Use My Keys
                </button>
            </div>
        </form>
    </div>

    <!-- Reset to Demo -->
    @if (Model.CredentialSource == CredentialSource.Session)
    {
        <div class="card border-2 border-dashed border-gray-300">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="font-semibold text-gray-900">Reset to Demo Credentials</h3>
                    <p class="text-sm text-gray-600">Clear your session credentials and revert to demo/environment configuration.</p>
                </div>
                <form method="post" asp-page-handler="Reset">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-secondary">
                        Reset to Demo
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Get API Keys Help -->
    <div class="mt-8 p-6 bg-gray-50 rounded-xl">
        <h3 class="font-semibold text-gray-900 mb-3">Where to get your API keys</h3>
        <ol class="list-decimal list-inside text-sm text-gray-600 space-y-2">
            <li>Log in to your <a href="https://dashboard.stripe.com" target="_blank" rel="noopener" class="text-brand-600 hover:underline">Stripe Dashboard</a></li>
            <li>Go to Developers → API keys</li>
            <li>Make sure you're in <strong>Test mode</strong> (toggle at the top)</li>
            <li>Copy your Publishable key and Secret key</li>
            <li>For webhooks, use Stripe CLI or create a webhook endpoint in the dashboard</li>
        </ol>
    </div>
</div>
